{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Separate Cloudflare Worker project for the admin panel. This is a brand
  // new project -- it must NEVER be pointed at the public site's Worker name,
  // domain, or bindings. See docs/admin-panel-architecture.html for the full
  // "do not touch kriyayogamission dev/production" restriction.
  "name": "kriyayogamission-admin",
  "compatibility_date": "2025-01-01",
  "main": "./worker/index.ts",

  // Static assets = the built React SPA (dist/client after `vite build`).
  // "single-page-application" fallback means any unmatched path serves
  // index.html so client-side routing works on refresh/deep links.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // Provisioned for THIS project only (kriyayogamission-admin), in the
  // Cloudflare dashboard -- never pointed at anything belonging to the
  // public kriyayogamission site. Native Worker bindings only need the
  // bucket/database name+id, not the S3 API endpoint (that endpoint is
  // only relevant if something used the S3-compatible API directly).
  "r2_buckets": [
    { "binding": "GALLERY_BUCKET", "bucket_name": "kriyayogamission-admin-gallery" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kriyayogamission-admin-db",
      "database_id": "df17af39-10fa-49dd-89b9-a71b662e43bc"
    }
  ],

  "observability": {
    "enabled": true
  },

  // Not sensitive -- GA4 property IDs are visible in Google's own UI URLs
  // to anyone with view access, and grant nothing on their own without
  // the service account credentials below. Those credentials
  // (GA4_SERVICE_ACCOUNT_EMAIL, GA4_SERVICE_ACCOUNT_PRIVATE_KEY) are real
  // secrets and are set via `wrangler secret put`, never committed here.
  //
  // IMPORTANT: unlike secrets, `vars` are NOT persistent across deploys --
  // they live in this file and get fully overwritten by whatever's
  // committed every time `wrangler deploy` runs (including Cloudflare's
  // automatic Workers Build on every push). If you ever change this value
  // by hand in the Cloudflare dashboard instead of here, the next deploy
  // will silently revert it and break Analytics again. Always edit it
  // here, not in the dashboard.
  "vars": {
    "GA4_PROPERTY_ID": "558900253",
    // Matches the resource_id used by the existing Search Console quick
    // link (sc-domain properties cover http+https+all subdomains as one
    // unit -- confirm this is actually how the property is verified in
    // Search Console before relying on it; a URL-prefix property would
    // need the literal verified URL instead, e.g. "https://kriyayogamission.org/").
    "GSC_SITE_URL": "sc-domain:kriyayogamission.org"
  }
}
